 "texts": {
  "en": {
   "20070610": "Brave Tarnished, become Lord. Enact thy will!",
   "20080400": "Enough, of this kingly folly!",
   "206809100": "Be proud, warrior. There is no shame in defeat to a king.",
   "206804000": "A true warrior thou art...",
   "206804010": "Use thy might to become Elden Lord."
  },
  "zh": {
   "20070610": "勇敢的褪色者啊，成为王吧。去实现你的意志！",
   "20080400": "够了，别再做这为王的蠢事！",
   "206809100": "骄傲吧，战士。败给王，并不可耻。",
   "206804000": "你是真正的战士……",
   "206804010": "用你的力量，成为艾尔登之王吧。"
  }
